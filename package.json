{
  "name": "i18n-trace",
  "displayName": "I18nTrace",
  "description": "在代码中常驻显示 i18n 译文，并支持按译文反查 key（增强 Ctrl+F）",
  "version": "1.0.2",
  "publisher": "linwm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lwm-xiaoxia/I18nTrace.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "i18n",
    "internationalization",
    "vue-i18n",
    "react-i18next",
    "inlay hints"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "i18nTrace.find",
        "title": "I18nTrace: 按译文查找（增强 Ctrl+F）"
      },
      {
        "command": "i18nTrace.switchDisplayLocale",
        "title": "I18nTrace: 切换显示语种"
      },
      {
        "command": "i18nTrace.reindex",
        "title": "I18nTrace: 重建索引"
      },
      {
        "command": "i18nTrace.toggleInlayHints",
        "title": "I18nTrace: 开关译文气泡"
      },
      {
        "command": "i18nTrace.showDiagnostics",
        "title": "I18nTrace: 显示诊断信息"
      }
    ],
    "keybindings": [
      {
        "command": "i18nTrace.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "editorTextFocus && !findWidgetVisible && !isInEmbeddedEditor && config.i18nTrace.search.enhanceCtrlF"
      }
    ],
    "configuration": {
      "title": "I18nTrace",
      "properties": {
        "i18nTrace.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 I18nTrace（关闭后不构建索引、不显示气泡）。"
        },
        "i18nTrace.localeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "手动指定语言文件目录或 glob（相对工作区根）。非空时完全以此为准，跳过自动检测。"
        },
        "i18nTrace.localeFileGlob": {
          "type": "string",
          "default": "**/{locale,locales,lang,langs,language,languages,i18n,i18n-locales,intl,translation,translations,messages}/**/*.{json,json5,yaml,yml,js,ts,mjs,cjs}",
          "description": "自动检测语言文件使用的 glob。"
        },
        "i18nTrace.displayLocale": {
          "type": "string",
          "default": "",
          "description": "气泡显示的语种代码（如 zh-CN）。留空则自动选择（优先中文，其次第一个）。"
        },
        "i18nTrace.sourceLocale": {
          "type": "string",
          "default": "",
          "description": "按译文反查时使用的语种代码。留空则使用当前显示语种。"
        },
        "i18nTrace.keySeparator": {
          "type": "string",
          "default": ".",
          "minLength": 1,
          "description": "嵌套语言对象拍平时的 key 分隔符。i18next / vue-i18n 默认使用点号；语言文件内原本就是扁平 key 时会原样保留。"
        },
        "i18nTrace.keyPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "++",
            "+",
            "@",
            "#"
          ],
          "description": "仅在原 key 未命中时尝试剥离的自定义 key 前缀。清空可完全关闭该兼容逻辑。"
        },
        "i18nTrace.translationFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "t",
            "$t",
            "$tc",
            "i18n.t",
            "i18n.global.t",
            "translate",
            "$translate",
            "translate.instant",
            "translate.get",
            "translate.stream",
            "transloco.translate"
          ],
          "description": "识别为翻译函数的名称（支持点号形式，如 i18n.t、translate.instant）。"
        },
        "i18nTrace.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "显示译文 Inlay Hint 气泡。"
        },
        "i18nTrace.inlayHints.maxLength": {
          "type": "number",
          "default": 40,
          "minimum": 4,
          "description": "气泡译文超过该长度时截断。"
        },
        "i18nTrace.inlayHints.showWhenMissing": {
          "type": "boolean",
          "default": true,
          "description": "key 在语言文件中找不到时，显示 ⚠️ 提示气泡。"
        },
        "i18nTrace.inlayHints.wrap": {
          "type": "string",
          "enum": [
            "none",
            "「」",
            "『』",
            "【】",
            "‹›",
            "()",
            "[]"
          ],
          "default": "none",
          "description": "给行内译文加一对包裹符，便于和代码里的真实字符串区分。none 表示不加。"
        },
        "i18nTrace.languageSelector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "vue",
            "html",
            "svelte",
            "astro"
          ],
          "description": "启用译文气泡与增强查找的语言（languageId）。"
        },
        "i18nTrace.search.enhanceCtrlF": {
          "type": "boolean",
          "default": true,
          "description": "把编辑器内 Ctrl+F 增强为「按译文查找」（无译文命中时等价普通查找）。关闭后 Ctrl+F 完全恢复原生。"
        },
        "i18nTrace.search.maxKeysPerSearch": {
          "type": "number",
          "default": 50,
          "description": "单次增强查找最多纳入的 key 数量，超出则截断并提示。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "pretest": "pnpm run compile-tests && pnpm run build",
    "test": "vscode-test",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "package": "vsce package --no-dependencies",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  }
}
